# Which stats provider to use:
#   "seed"     -> in-memory representative build stats (default; zero setup, no DB needed)
#   "postgres" -> read aggregated stats from Postgres via Drizzle (requires DATABASE_URL + seeded DB)
STATS_PROVIDER=seed

# Postgres connection (used by Drizzle migrations/seed and the "postgres" provider).
# Matches docker-compose. For the app container, host is "db"; for local dev, "localhost".
DATABASE_URL=postgres://buildmax:buildmax@localhost:5432/buildmax

# Riot API key (only needed for the real ingestion pipeline; the MVP does not require it).
# Get one at https://developer.riotgames.com/. Dev keys expire every 24h.
RIOT_API_KEY=

# Data Dragon locale used by the sync script.
DDRAGON_LOCALE=en_US
